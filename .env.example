# ====================================================
# CashFlow Guardian AI - Environment Configuration
# ====================================================

# ----------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite)
# ----------------------------------------------------
# Base URL for the FastAPI backend API
# Local development default: http://localhost:8000/api
# Production example: https://your-backend-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Set to 'false' to connect to live FastAPI ML backend
VITE_USE_MOCK_API=false

# Application environment ('development' | 'production')
VITE_APP_ENV=development

# ----------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (FastAPI / Uvicorn)
# ----------------------------------------------------
# Server port
PORT=8000
HOST=0.0.0.0
ENV=development

# Database persistence connection URL
DATABASE_URL=sqlite:///./cashflow_guardian.db

# Allowed CORS Origins (comma-separated domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------
# 3. PAYMENT PROVIDER CONFIGURATION (Razorpay Test Mode)
# ----------------------------------------------------
# Active payment provider: 'demo' or 'razorpay'
PAYMENT_PROVIDER=demo

# Razorpay Test Mode Credentials
# Required when PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
